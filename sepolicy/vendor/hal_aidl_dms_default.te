type hal_aidl_dms_default, domain;
hal_server_domain(hal_aidl_dms_default, hal_aidl_dms)

type hal_aidl_dms_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_aidl_dms_default)

binder_use(hal_aidl_dms_default)

set_prop(hal_aidl_dms_default, vendor_audio_prop)

allow hal_aidl_dms_default vendor_dolby_data_file:dir create_dir_perms;
allow hal_aidl_dms_default vendor_dolby_data_file:file create_file_perms;
